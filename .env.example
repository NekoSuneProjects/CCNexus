PORT=3000
CCNEXUS_PUBLIC_URL=https://ccnexus.example.com
# First boot is completed in the web UI. Database credentials are saved to data/config.json.

# Media toolchain defaults for standalone/Pterodactyl installs.
# CCNexus downloads managed tools into data/tools unless a binary override is supplied.
YTDLP_AUTO_UPDATE=true
YTDLP_CHANNEL=nightly
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_YOUTUBE_CLIENT=mweb
DENO_AUTO_INSTALL=true

# Optional YouTube authentication cookies. If unset, CCNexus automatically
# checks data/youtube-cookies.txt for a Netscape-format cookies file.
# YTDLP_COOKIES_FILE=/home/container/data/youtube-cookies.txt

# Speaker/radio buffering. 64 KiB is about 1.36s of 48 kHz 8-bit mono PCM.
# Live radio waits for roughly 2s of PCM before starting to absorb network jitter.
# Keep AUDIO_CHUNK_BYTES <= 81920 so base64+JSON stays under ComputerCraft's
# default 128 KiB websocket-message limit.
CCNEXUS_AUDIO_CHUNK_BYTES=65536
CCNEXUS_RADIO_PREBUFFER_BYTES=98304

# Optional binary overrides:
# YTDLP_BIN=/custom/path/yt-dlp
# DENO_BIN=/custom/path/deno
# FFMPEG_BIN=ffmpeg
# TTS_BIN=espeak-ng
