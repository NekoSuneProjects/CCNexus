PORT=3000
CCNEXUS_PUBLIC_URL=https://ccnexus.example.com
# First boot is completed in the web UI. Database credentials are saved to data/config.json.

# Media toolchain defaults for standalone/Pterodactyl/Docker installs.
# CCNexus downloads managed tools into data/tools unless a binary override is supplied.
YTDLP_AUTO_UPDATE=true
YTDLP_CHANNEL=nightly
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_YOUTUBE_CLIENT=mweb
DENO_AUTO_INSTALL=true

# Preferred YouTube resolver. CCNexus asks this /info endpoint first, selects
# audio-only 251/140/250/249 where possible, probes the returned signed URL from
# this server, and falls back to managed local yt-dlp if the remote URL is not usable.
CCNEXUS_YOUTUBE_INFO_ENABLED=true
CCNEXUS_YOUTUBE_INFO_API=https://dl.nekosunevr.co.uk/info
CCNEXUS_YOUTUBE_INFO_PROBE=true

# Optional YouTube authentication cookies for the local yt-dlp fallback. If unset,
# CCNexus automatically checks data/youtube-cookies.txt for a Netscape-format file.
# YTDLP_COOKIES_FILE=/home/container/data/youtube-cookies.txt

# Built-in CPU-only TTS. This uses eSpeak-NG compiled to JavaScript/WebAssembly
# through the text2wav package, so no GPU/CUDA or system espeak-ng package is required.
CCNEXUS_TTS_ENGINE=wasm
# To deliberately use a system executable instead:
# CCNEXUS_TTS_ENGINE=external
# TTS_BIN=espeak-ng

# Speaker/radio buffering. 64 KiB is about 1.36s of 48 kHz 8-bit mono PCM.
# Live radio waits for roughly 2s of PCM before starting to absorb network jitter.
# Keep AUDIO_CHUNK_BYTES <= 81920 so base64+JSON stays under ComputerCraft's
# default 128 KiB websocket-message limit.
CCNEXUS_AUDIO_CHUNK_BYTES=65536
CCNEXUS_RADIO_PREBUFFER_BYTES=98304

# Optional binary overrides:
# YTDLP_BIN=/custom/path/yt-dlp
# DENO_BIN=/custom/path/deno
# FFMPEG_BIN=ffmpeg
