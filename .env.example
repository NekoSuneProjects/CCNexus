PORT=3000
CCNEXUS_PUBLIC_URL=https://ccnexus.example.com
# First boot is completed in the web UI. Database credentials are saved to data/config.json.

# Media toolchain defaults for standalone/Pterodactyl installs.
# CCNexus downloads managed tools into data/tools unless a binary override is supplied.
YTDLP_AUTO_UPDATE=true
YTDLP_CHANNEL=nightly
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_YOUTUBE_CLIENT=mweb
DENO_AUTO_INSTALL=true

# Optional binary overrides:
# YTDLP_BIN=/custom/path/yt-dlp
# DENO_BIN=/custom/path/deno
# FFMPEG_BIN=ffmpeg
# TTS_BIN=espeak-ng
